{
  "client_id": "YOUR_GOOGLE_CLOUD_CLIENT_ID.apps.googleusercontent.com",
  "client_secret": "YOUR_GOOGLE_CLOUD_CLIENT_SECRET",
  "accounts": {
    "personal": {
      "description": "Personal Google account"
    },
    "work": {
      "description": "Work Google Workspace"
    }
  },
  "sanitization": {
    "max_email_body_chars": 2000,
    "max_doc_chars": 8000,
    "max_sheet_cells": 200,
    "max_calendar_description_chars": 1000,
    "strip_html": true,
    "neutralize_injections": true
  },
  "logging": {
    "audit_log_path": "~/.config/google-account/audit.jsonl"
  },
  "token_dir": "~/.config/google-account/tokens"
}
